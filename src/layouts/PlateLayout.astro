---
// The landing page's document. `swap` faces: its first paint was tuned around them.
import '../styles/faces.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Head, { type Props } from '../components/site/Head.astro';

const { lang } = Astro.props as Props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<Head {...(Astro.props as Props)} manifest={false}><slot name="head" slot="head" /></Head>
	</head>
	<body>
		<slot />
		{/* After the fonts and the frame they paint, so neither competes with the first paint: linked in
		    the head, or added on load (56 ms locally, before the fonts' paint at 121 ms), the manifest
		    was fetched beside the fonts and the simulated LCP ended later (1433 → 1508 ms, measured). */}
		<script is:inline define:vars={{ manifestHref: lang === 'tr' ? '/tr/manifest.webmanifest' : '/manifest.webmanifest' }}>
			addEventListener('load', () =>
				Promise.resolve(document.fonts?.ready).then(() =>
					requestAnimationFrame(() =>
						setTimeout(() => {
							const link = document.createElement('link');
							link.rel = 'manifest';
							link.href = manifestHref;
							document.head.append(link);
							if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
						}, 0),
					),
				),
			);
		</script>
	</body>
</html>
