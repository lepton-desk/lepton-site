---
import BlogPost from '../../components/blog/BlogPost.astro';
import { postsIn, slugOf } from '../../components/blog/posts';

export async function getStaticPaths() {
	const other = new Set((await postsIn('tr')).map(slugOf));
	return (await postsIn('en')).map((post) => ({ params: { slug: slugOf(post) }, props: { post, translated: other.has(slugOf(post)) } }));
}
const { post, translated } = Astro.props;
---

<BlogPost post={post} translated={translated} />
