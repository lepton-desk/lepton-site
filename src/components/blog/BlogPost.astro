---
// One post: a framed plate header (date, claim, lead, a grease-pencil note), then the text.
import { render } from 'astro:content';
import ReadLayout from '../../layouts/ReadLayout.astro';
import Fiducials from '../landing/Fiducials.astro';
import { site } from '../../i18n/site';
import { authors } from '../../data/authors';
import { type Post, langOf, slugOf, hrefOf, minutesOf } from './posts';

interface Props {
	post: Post;
	/** The same post in the other language, when it exists. */
	translated: boolean;
}
const { post, translated } = Astro.props;
const lang = langOf(post);
const slug = slugOf(post);
const t = site[lang];
const other = lang === 'tr' ? 'en' : 'tr';
const here = hrefOf(lang, slug);
const there = translated ? hrefOf(other, slug) : site[other].blogHref;
const { headings } = await render(post);
const contents = headings.filter((h) => h.depth === 2);
// The text before the first heading is drawn in the first frame; each section after it is added
// after that frame, one task each (they arrive as <noscript>, so without scripting they show as
// they are). Drawn all at once, a post's first frame came late enough under Lighthouse's mid-load
// resize for Chrome to hold the page's frames for a second (measured: 8 of 8 runs held, 0 of 8
// split like this; one task for the whole body cost CLS 0.1 and 117 ms TBT).
const [lead = '', ...sections] = (post.rendered?.html ?? '').split(/(?=<h2[\s>])/);
const hasCode = /^```/m.test(post.body ?? '');
---

<ReadLayout
	lang={lang}
	title={`${post.data.title} — Lepton`}
	description={post.data.description}
	path={here}
	paths={translated ? { en: hrefOf('en', slug), tr: hrefOf('tr', slug) } : undefined}
	switchTo={lang === 'tr' ? { en: there, tr: here } : { en: here, tr: there }}
	preload={['archivo', ...(post.data.note ? (['kalam'] as const) : []), ...(hasCode ? (['jbmono'] as const) : [])]}
	ogType="article"
	current="blog"
>
	<main>
	<article>
		<header class="head">
			<Fiducials />
			<p class="meta">
				<time datetime={post.data.date.toISOString().slice(0, 10)}>{t.date(post.data.date)}</time>
				<span aria-hidden="true">·</span>
				<span>{t.minutes(minutesOf(post))}</span>
			</p>
			<h1>{post.data.title}</h1>
			<p class="lead">{post.data.description}</p>
			<p class="byline">
				{t.by}{' '}
				{post.data.authors.map((id, index) => (
					<>
						{index > 0 && ', '}
						<a href={authors[id].href} rel="author">{authors[id].name}</a>, {authors[id].role[lang]}
					</>
				))}
			</p>
			{post.data.note && <p class="note">{post.data.note}</p>}
			{
				translated && (
					<p class="other">
						<a href={there} hreflang={other} lang={other}>{t.readInTr}</a>
					</p>
				)
			}
		</header>
		<div class="body">
			<div class="prose" data-later-box>
				<Fragment set:html={lead} />
				{sections.map((section) => <noscript data-later set:html={section} />)}
			</div>
			{
				contents.length > 2 && (
					<nav class="contents" aria-label={t.contents}>
						<p>{t.contents}</p>
						<ol>
							{contents.map((h) => (
								<li><a href={`#${h.slug}`}>{h.text}</a></li>
							))}
						</ol>
					</nav>
				)
			}
		</div>
	</article>
	</main>
	<script is:inline>
		(() => {
			const later = [...document.querySelectorAll('noscript[data-later]')];
			const next = () => {
				const block = later.shift();
				if (!block) {
					// A link to a section lands once that section exists.
					const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
					if (target) target.scrollIntoView({ behavior: 'instant' });
					return;
				}
				const parsed = document.createElement('template');
				parsed.innerHTML = block.textContent ?? '';
				// Scripts parsed this way do not run; code blocks bring their copy button's module.
				for (const old of parsed.content.querySelectorAll('script')) {
					const script = document.createElement('script');
					for (const { name, value } of old.attributes) script.setAttribute(name, value);
					script.textContent = old.textContent;
					old.replaceWith(script);
				}
				block.replaceWith(parsed.content);
				setTimeout(next, 0);
			};
			let started = false;
			const start = () => {
				if (started) return;
				started = true;
				setTimeout(next, 0);
			};
			requestAnimationFrame(start);
			// A page that gets no frames (hidden, occluded) still fills in.
			setTimeout(start, 1000);
		})();
	</script>
</ReadLayout>

<style>
	.head {
		position: relative;
		padding: var(--space-6) var(--gutter) var(--space-5);
		border-bottom: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
	}
	.meta {
		display: flex;
		gap: 0.6em;
		margin: 0 0 var(--space-3);
		font-size: var(--step--1);
		font-weight: 650;
		font-stretch: 85%;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}
	h1 {
		margin: 0 0 var(--space-3);
		max-width: 16em;
		font-size: var(--step-3);
		font-stretch: 66%;
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.015em;
	}
	.lead {
		margin: 0;
		max-width: 36em;
		font-size: var(--step-1);
		line-height: 1.45;
		color: var(--ink-soft);
	}
	/* The annotator's hand: a short pencil leader, then the note. */
	.note {
		display: flex;
		align-items: center;
		gap: 0.6em;
		margin: var(--space-4) 0 0;
		font-family: var(--font-hand);
		font-weight: 700;
		font-size: var(--step-1);
		line-height: 1.2;
		color: var(--pencil);
	}
	.note::before {
		content: '';
		flex: none;
		width: 2.2rem;
		height: 1.6px;
		background: var(--pencil);
		transform: rotate(-18deg);
	}
	/* Room for the sections still to come, so the footer is not seen and then pushed down. */
	.prose:has(> noscript[data-later]) {
		min-height: 100vh;
	}
	.prose {
		padding: var(--space-5) var(--gutter) var(--space-6);
		max-width: calc(68ch + 2 * var(--gutter));
		scroll-margin-top: var(--space-4);
		line-height: 1.6;
	}
	.byline {
		margin: var(--space-3) 0 0;
		font-size: var(--step--1);
		font-weight: 600;
		color: var(--ink-soft);
	}
	.byline a {
		color: var(--ink);
	}
	.other {
		margin: var(--space-3) 0 0;
		font-size: var(--step--1);
		font-weight: 600;
	}
	.body {
		display: grid;
		grid-template-columns: minmax(0, calc(68ch + 2 * var(--gutter))) minmax(0, 1fr);
	}
	/* Contents, on screens wide enough to keep it beside the text. */
	.contents {
		align-self: start;
		position: sticky;
		top: var(--space-4);
		margin: var(--space-5) var(--gutter) 0 0;
		max-width: 18rem;
		border-top: 2px solid var(--ink);
	}
	.contents p {
		margin: 0;
		padding: 0.7em 0;
		font-size: var(--step--1);
		font-weight: 650;
		font-stretch: 85%;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.contents ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.contents li {
		border-top: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
	}
	.contents a {
		display: block;
		padding: 0.55em 0;
		font-weight: 600;
		font-stretch: 85%;
		line-height: 1.25;
		text-decoration: none;
	}
	.contents a:hover {
		text-decoration: underline;
		text-decoration-color: var(--pencil);
		text-decoration-thickness: 2px;
	}
	@media (max-width: 75rem) {
		.body {
			display: block;
		}
		.contents {
			display: none;
		}
	}

	.prose :global(h2) {
		scroll-margin-top: var(--space-4);
		margin: var(--space-5) 0 var(--space-2);
		font-size: var(--step-2);
		font-stretch: 75%;
		font-weight: 750;
		line-height: 1.1;
	}
	.prose :global(h3) {
		margin: var(--space-4) 0 var(--space-1);
		font-size: var(--step-1);
		font-stretch: 80%;
		font-weight: 700;
		line-height: 1.2;
	}
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 var(--space-3);
	}
	.prose :global(li) {
		margin-bottom: 0.35em;
	}
	.prose :global(li::marker) {
		color: var(--ink-soft);
	}
	.prose :global(a:hover) {
		text-decoration-color: var(--pencil);
		text-decoration-thickness: 2px;
	}
	.prose :global(strong) {
		font-weight: 700;
	}
	.prose :global(:not(pre) > code) {
		font-family: var(--font-mono);
		font-size: 0.86em;
		padding: 0.1em 0.3em;
		background: var(--paper);
		border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
	}
	/* Code blocks come framed by Expressive Code (Starlight runs it for all Markdown). */
	.prose :global(.expressive-code) {
		margin: 0 0 var(--space-4);
	}
	/* Tables as a data sheet: paper, uppercase heads over a 2px ink rule, tabular figures. */
	.prose :global(table) {
		width: 100%;
		margin: 0 0 var(--space-4);
		border-collapse: collapse;
		background: var(--paper);
		font-variant-numeric: tabular-nums;
		box-shadow:
			0 1px 1px rgb(27 29 28 / 0.12),
			0 22px 40px -28px rgb(27 29 28 / 0.6);
	}
	.prose :global(th) {
		padding: 0.7em 0.9em;
		border-bottom: 2px solid var(--ink);
		text-align: left;
		font-size: var(--step--1);
		font-weight: 650;
		font-stretch: 85%;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.prose :global(td) {
		padding: 0.6em 0.9em;
		border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
		vertical-align: top;
	}
	.prose :global(blockquote) {
		margin: 0 0 var(--space-3);
		padding-left: var(--space-3);
		border-left: 1px solid var(--ink);
		color: var(--ink-soft);
	}
	.prose :global(hr) {
		margin: var(--space-5) 0;
		border: 0;
		border-top: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
	}
	@media (max-width: 47.5rem) {
		.prose :global(table) {
			display: block;
			overflow-x: auto;
		}
	}
</style>
