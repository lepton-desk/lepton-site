---
// The Lepton mark: an interaction vertex (grease-pencil ring) and the track of a lepton
// curling as it loses energy, as on a bubble-chamber plate.
interface Props {
	size?: number;
	wordmark?: boolean;
	class?: string;
}
const { size = 32, wordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
	<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
		<path
			d="M8.5 24 C 11 12, 22 4.5, 27.2 11.5 C 31 17, 25.5 23.5, 20.6 20.6 C 16.8 18.3, 19.2 13.2, 22.7 14.6 C 25 15.6, 24 18.8, 22.1 18.1"
			fill="none"
			stroke="currentColor"
			stroke-width="2.4"
			stroke-linecap="round"
		></path>
		<path d="M1.5 26.8 L 8.5 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.55"></path>
		<circle cx="8.5" cy="24" r="3.6" fill="none" stroke="var(--pencil)" stroke-width="2"></circle>
	</svg>
	{wordmark && <span class="word">Lepton</span>}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--ink);
	}
	.word {
		font-family: var(--font-sans);
		font-stretch: 70%;
		font-weight: 800;
		font-size: 1.35rem;
		letter-spacing: -0.01em;
		line-height: 1;
	}
</style>
