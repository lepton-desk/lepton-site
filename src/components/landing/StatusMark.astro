---
// How a plate is marked by hand: a filled stamp for what works, an outline for experimental,
// a dashed box for the next release, grease pencil for what is only planned, and plain pencil
// type, no mark at all, for what Lepton does not support.
import type { Status } from '../../i18n/landing';

interface Props {
	status: Status;
	label: string;
}
const { status, label } = Astro.props;
---

<span class:list={['mark', status]}>{label}</span>

<style>
	.mark {
		display: inline-block;
		padding: 0.2em 0.6em 0.25em;
		font-size: var(--step--1);
		font-weight: 650;
		font-stretch: 85%;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		line-height: 1.2;
		white-space: nowrap;
	}
	.works {
		background: var(--ink);
		color: var(--paper);
	}
	.experimental {
		border: 1.5px solid var(--ink);
	}
	.next {
		border: 1.5px dashed var(--ink);
	}
	.planned {
		padding-inline: 0;
		font-family: var(--font-hand);
		font-size: var(--step-0);
		font-weight: 700;
		letter-spacing: 0;
		text-transform: none;
		color: var(--pencil);
	}
	.unsupported {
		padding-inline: 0;
		color: var(--pencil);
	}
</style>
