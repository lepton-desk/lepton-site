---
// A plate's registration marks: four fiducial crosses at the corners and a scale-tick ruler
// along the top edge. Every section frame carries them; the parent must be positioned.
interface Props {
	tone?: 'ink' | 'paper';
	ruler?: boolean;
}
const { tone = 'ink', ruler = true } = Astro.props;
---

<span class:list={['marks', tone]} aria-hidden="true">
	<span class="fid tl"></span><span class="fid tr"></span><span class="fid bl"></span><span class="fid br"></span>
	{ruler && <span class="ruler"></span>}
</span>

<style>
	.marks {
		position: absolute;
		inset: 0;
		pointer-events: none;
		--mark: var(--ink);
	}
	.paper {
		--mark: rgb(242 241 235 / 0.7);
	}
	.fid {
		position: absolute;
		width: 22px;
		height: 22px;
	}
	.fid::before,
	.fid::after {
		content: '';
		position: absolute;
		background: var(--mark);
	}
	.fid::before {
		left: 10px;
		width: 2px;
		height: 100%;
	}
	.fid::after {
		top: 10px;
		height: 2px;
		width: 100%;
	}
	.tl {
		left: 14px;
		top: 30px;
	}
	.tr {
		right: 14px;
		top: 30px;
	}
	.bl {
		left: 14px;
		bottom: 14px;
	}
	.br {
		right: 14px;
		bottom: 14px;
	}
	.ruler {
		position: absolute;
		left: 50px;
		right: 50px;
		top: 0;
		height: 12px;
		background:
			repeating-linear-gradient(90deg, var(--mark) 0 1.5px, transparent 1.5px 70px) top / 100% 12px no-repeat,
			repeating-linear-gradient(90deg, var(--mark) 0 1px, transparent 1px 14px) top / 100% 6px no-repeat;
		opacity: 0.55;
	}
</style>
