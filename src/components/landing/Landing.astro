---
import PlateLayout from '../../layouts/PlateLayout.astro';
import { landing, type Lang } from '../../i18n/landing';
import Plate from './Plate.astro';
import Engines from './Engines.astro';
import EventDiagram from './EventDiagram.astro';
import CodeSample from './CodeSample.astro';
import CliRun from './CliRun.astro';
import StatusTable from './StatusTable.astro';
import Close from './Close.astro';

interface Props {
	lang: Lang;
}
const text = landing[Astro.props.lang];
---

<PlateLayout text={text}>
	<Plate text={text} />
	<main>
		<Engines text={text} />
		<EventDiagram text={text} />
		<CodeSample text={text} />
		<CliRun text={text} />
		<StatusTable text={text} />
		<Close text={text} />
	</main>
</PlateLayout>

<style>
	/* Sections below the first viewport are laid out when they come near it, not before the
	   first paint: style and layout of the whole page held the first paint back (measured). */
	main > :global(section) {
		content-visibility: auto;
		contain-intrinsic-size: auto 900px;
	}
</style>
