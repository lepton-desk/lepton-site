---
// The three things a visitor came to do, at equal weight: copy the command, open the docs,
// open the source. One row, one height, one frame language.
import CommandStrip from './CommandStrip.astro';
import { githubUrl } from '../../i18n/landing';

interface Props {
	copy: string;
	copied: string;
	docs: string;
	docsHref: string;
	github: string;
}
const { copy, copied, docs, docsHref, github } = Astro.props;
---

<div class="actions">
	<CommandStrip copy={copy} copied={copied} />
	<a class="action" href={docsHref}>
		<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
			<path d="M2.5 3h4.2c.8 0 1.3.5 1.3 1.3V13c0-.6-.5-1-1.1-1H2.5zM13.5 3H9.3C8.5 3 8 3.5 8 4.3V13c0-.6.5-1 1.1-1h4.4z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
		</svg>
		{docs}
	</a>
	<a class="action" href={githubUrl}>
		<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
			<path d="M8 1.5a6.5 6.5 0 0 0-2.06 12.67c.33.06.44-.14.44-.31v-1.1c-1.8.39-2.18-.87-2.18-.87-.3-.75-.72-.95-.72-.95-.59-.4.04-.4.04-.4.65.05 1 .67 1 .67.58 1 1.52.71 1.89.54.06-.42.23-.71.41-.87-1.44-.16-2.95-.72-2.95-3.2 0-.71.25-1.29.67-1.74-.07-.17-.29-.83.06-1.72 0 0 .55-.18 1.79.66a6.2 6.2 0 0 1 3.26 0c1.24-.84 1.79-.66 1.79-.66.35.9.13 1.55.06 1.72.42.45.67 1.03.67 1.74 0 2.49-1.52 3.04-2.96 3.2.23.2.44.6.44 1.2v1.78c0 .17.11.38.45.31A6.5 6.5 0 0 0 8 1.5z" fill="currentColor"></path>
		</svg>
		{github}
	</a>
</div>

<style>
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		align-items: stretch;
	}
	.action {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		min-height: 3.4rem;
		padding: 0 1em;
		border: 2px solid var(--ink);
		background: var(--paper);
		color: var(--ink);
		font-family: 'Archivo', 'Plate Button Fallback';
		font-weight: 650;
		font-stretch: 88%;
		font-size: var(--step-0);
		text-decoration: none;
		box-shadow: 0 1px 1px rgb(27 29 28 / 0.2), 0 10px 28px -16px rgb(27 29 28 / 0.55);
		transition: background-color 240ms var(--ease-out), color 240ms var(--ease-out);
	}
	.action:hover {
		background: var(--ink);
		color: var(--paper);
	}
	.actions :global(.strip) {
		min-height: 3.4rem;
	}
	@media (max-width: 30rem) {
		.actions {
			display: grid;
			grid-template-columns: 1fr;
		}
		.action {
			justify-content: center;
		}
	}
</style>
